{
  "name": "@mashit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/functions.js",
  "dependencies": {
    "@azure/functions": "^4.5.0",
    "@mashit/core": "*",
    "@mashit/integrations": "*",
    "@mashit/narrative": "*",
    "@mashit/report": "*"
  },
  "scripts": {
    "build": "esbuild src/functions.ts src/cli.ts src/devserver.ts --bundle --platform=node --format=esm --target=node20 --outdir=dist --external:@azure/functions --external:@anthropic-ai/sdk --external:playwright --external:pptxgenjs",
    "start": "func start",
    "typecheck": "tsc -p tsconfig.json"
  }
}
