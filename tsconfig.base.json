{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@mashit/core": ["./packages/core/src/index.ts"],
      "@mashit/core/*": ["./packages/core/src/*"],
      "@mashit/integrations": ["./packages/integrations/src/index.ts"],
      "@mashit/integrations/*": ["./packages/integrations/src/*"],
      "@mashit/narrative": ["./packages/narrative/src/index.ts"],
      "@mashit/narrative/*": ["./packages/narrative/src/*"],
      "@mashit/report": ["./packages/report/src/index.ts"],
      "@mashit/report/*": ["./packages/report/src/*"]
    }
  }
}
